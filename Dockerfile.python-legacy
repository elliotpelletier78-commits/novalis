# ⚠️ LEGACY — app Python (main.py) NON déployée. Renommé depuis « Dockerfile »
# pour qu'aucune plateforme ne l'auto-détecte et ne déploie la mauvaise app.
# Le déploiement réel est décidé par railway.toml → Dockerfile.node.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
