# ============================================================
# NOVALIS IA — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- IA (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# --- Twilio SMS/Voix (optionnel — désactive SMS/Voix si absent) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxx
TWILIO_PHONE=+15140000000
OWNER_PHONE=+15140000000

# --- ElevenLabs TTS (optionnel — voix naturelle sur les appels) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Facebook Messenger (optionnel) ---
FB_VERIFY_TOKEN=novalis_verify_token
FB_APP_SECRET=

# --- Vapi — Agent vocal IA (optionnel) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- Admin plateforme ---
ADMIN_USER=admin
ADMIN_PASS=changeme_obligatoire

# --- Sécurité ---
# ⚠️  CRITIQUE : sans PLATFORM_SECRET, les sessions du portail expirent à chaque redémarrage.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_SECRET=generez-une-cle-secrete-ici
ALLOWED_ORIGINS=https://votre-domaine.railway.app

# --- URL publique (obligatoire pour ElevenLabs voice + Stripe) ---
APP_URL=https://votre-domaine.railway.app

# --- Stripe — Facturation abonnements (optionnel) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxx

# --- Email SMTP (optionnel — notifications et rapports) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre-mot-de-passe-app
SMTP_FROM=noreply@novalis.ai
ADMIN_EMAIL=votre@email.com

# --- Base de données ---
DATABASE_PATH=/data/novalis.db

# ── Noyau d'automatisation ──────────────────────────────────────────
# Clé maître du coffre à credentials clients (64 caractères hex).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATOIRE en production. Sans elle, le coffre refuse de fonctionner.
MASTER_KEY=

# Clé API Anthropic pour la passerelle LLM (comptage coûts par client).
ANTHROPIC_API_KEY=
