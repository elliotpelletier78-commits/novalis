# ============================================================
# NOVALIS — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Rien de secret ne va dans le code : tout passe par ici (ou par le coffre
# chiffré pour les jetons des commerçants).
# ============================================================

# ── Base (obligatoire en production) ────────────────────────────────
# Clé maître du coffre chiffré (jetons OAuth des commerçants, secrets).
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans elle, le coffre refuse de fonctionner.
MASTER_KEY=

# Mot de passe du poste de commande (rôle admin).
ADMIN_PASS=changez-moi
# Mot de passe d'un employé en lecture seule (optionnel).
EMPLOYE_PASS=

# Chemin du fichier SQLite (défaut : ./novalis.db).
DATABASE_PATH=/data/novalis.db
# Port HTTP (défaut : 3000).
PORT=3000

# ── Rédaction IA des brouillons (optionnel) ─────────────────────────
# Sans clé, Novalis prépare des brouillons déterministes (repli sans IA).
ANTHROPIC_API_KEY=

# ── Envoi de courriel — repli global Resend (optionnel) ─────────────
# Utilisé UNIQUEMENT quand le commerçant n'a pas branché SON Gmail.
# Sans clé, l'approbation marque « à envoyer à la main » (jamais de faux envoi).
RESEND_API_KEY=
MAIL_FROM=Novalis <reponse@novalisia.ca>
# Alertes internes (optionnel) : courriel + webhook.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Novalis <alertes@novalisia.ca>
ALERT_WEBHOOK_URL=

# ── Branchement Gmail du commerçant (OAuth Google) ──────────────────
# Le commerçant connecte SON propre compte ; Novalis envoie depuis SA boîte.
# Créez l'app dans Google Cloud Console (voir docs/BRANCHEMENT.md).
# Sans ces clés, le branchement Gmail s'affiche « à activer » (jamais cassé).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Branchement QuickBooks du commerçant (OAuth Intuit) ─────────────
# Le commerçant connecte SON QuickBooks ; Novalis y prépare des factures.
# Créez l'app sur le portail développeur Intuit (voir docs/BRANCHEMENT.md).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# « sandbox » pour tester, « production » pour du réel (défaut : production).
QUICKBOOKS_ENV=sandbox

# ── Divers (optionnel) ──────────────────────────────────────────────
# Google Analytics sur la page publique.
GA_ID=
# Numéro WhatsApp affiché sur la page publique.
WHATSAPP_NUMERO=
# Origine autorisée pour les appels CRM entrants.
CRM_ORIGIN=
# Clé pour l'aperçu de site (prévisualisation).
PREVIEW_API_KEY=
# Environnement Node (« production » recommandé en déploiement).
NODE_ENV=production
# Charger des données de démonstration au démarrage (1 = oui). Laisser vide en prod.
IMPORTS_DEMOS_AU_DEMARRAGE=
# Sauvegarde automatique du fichier SQLite (1 = oui, 0 = non).
SAUVEGARDE_AUTO=1
