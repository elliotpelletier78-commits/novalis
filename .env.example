# ============================================================
# NOVALIS — Configuration d'environnement
# ============================================================
# IMPORTANT: Ne JAMAIS commiter ce fichier avec des vraies valeurs.
# Utilisez Railway Variables ou un gestionnaire de secrets.

# ── SÉCURITÉ CRITIQUE ────────────────────────────────────────
# Ces clés DOIVENT être générées et stockées de manière sécurisée.
# Régénérez-les immédiatement si compromises.

# Admin password pour les endpoints /admin/*
# Générez avec: openssl rand -base64 32
ADMIN_PASS=your-secure-admin-password-here

# Master key pour le chiffrement des credentials clients (AES-256)
# DOIT être 64 caractères hex (32 octets)
# Générez avec: openssl rand -hex 32
MASTER_KEY=your-64-char-hex-master-key-here

# Clé API Anthropic (Claude)
# Obtenez sur: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── SERVICES EXTERNES ────────────────────────────────────────

# Twilio (SMS/Voix)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Facebook Messenger
FB_VERIFY_TOKEN=your-fb-verify-token
FB_APP_SECRET=your-fb-app-secret

# ── CONFIGURATION ────────────────────────────────────────────

# Node environment
NODE_ENV=production

# Port serveur Node.js
PORT=3000

# Base de données SQLite
DATABASE_PATH=/app/output/novalis.db

# Service preview (Node.js)
PREVIEW_SERVICE_URL=https://novalis-production.up.railway.app
PREVIEW_API_KEY=your-preview-api-key

# CRM origin (override CORS si besoin)
CRM_ORIGIN=https://novalisia.ca

# Admin user
ADMIN_USER=admin

# Platform secret (sessions)
PLATFORM_SECRET=your-platform-secret-here

# ── ALERTES ──────────────────────────────────────────────────

# Webhook Discord/Slack pour les alertes
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── OWNER ────────────────────────────────────────────────────

# Numéro de téléphone du propriétaire (pour alertes SMS)
OWNER_PHONE=+1234567890

# ── CORS ─────────────────────────────────────────────────────

# Origines autorisées (séparées par virgule)
ALLOWED_ORIGINS=https://novalisia.ca,https://www.novalisia.ca

# ============================================================
# NOTES DE SÉCURITÉ
# ============================================================
# 1. JAMAIS commiter ce fichier avec des vraies valeurs
# 2. Utilisez Railway Variables pour la production
# 3. Régénérez les clés si compromises
# 4. Auditez les accès régulièrement
# 5. Loggez tous les appels IA (déjà fait dans llm.js)
# 6. Limitez les permissions par client (budget_llm_cents_mois)

