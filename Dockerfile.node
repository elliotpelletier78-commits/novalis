FROM node:20-slim
WORKDIR /app

# better-sqlite3 se compile depuis les sources : outils de build requis.
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

# Playwright n'est utilisé qu'en tests (devDependencies) — jamais à l'exécution.
# On coupe tout téléchargement de navigateur, même par précaution.
ENV NODE_ENV=production
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package*.json ./
# Dépendances de production seulement (pas playwright/eslint/vitest).
RUN npm install --omit=dev --no-audit --no-fund

COPY . .
EXPOSE 3000
CMD ["node", "server.js"]
